{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": { "driver": { "name": "example-scanner" } },
      "results": [
        {
          "ruleId": "RULE-EXAMPLE",
          "level": "error",
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "src/app.ts" }, "region": { "startLine": 10 } } }],
          "properties": { "reportable": true }
        },
        {
          "ruleId": "RULE-EXAMPLE",
          "level": "warning",
          "locations": [{ "physicalLocation": { "artifactLocation": { "uri": "src/app.ts" }, "region": { "startLine": 30 } } }],
          "properties": { "reportable": false }
        }
      ]
    }
  ]
}
