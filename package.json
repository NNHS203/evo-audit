{
  "name": "evo-audit",
  "version": "0.1.0",
  "description": "CLI-first, evidence-gated AI code auditing core",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "bin": {
    "evo-audit": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "benchmark:ci": "npm run build && node dist/src/cli.js benchmark ./benchmark/cases --manifest ./benchmark/benchmark-manifest.json --split development --min-recall 1 --min-precision 1 --max-fpr 0",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "benchmark",
    "docs"
  ],
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
